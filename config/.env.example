# ══════════════════════════════════════════════════════════
#  Helios AI Agent — Konfiguracja środowiskowa
#  Skopiuj jako .env i uzupełnij wartości
# ══════════════════════════════════════════════════════════

# ── Claude API ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Tożsamość agenta ──────────────────────────────────────
AGENT_NAME=Helios

# ── Bezpieczeństwo ────────────────────────────────────────
# Numery telefonów które mogą wydawać komendy (oddzielone przecinkiem)
# Użyj * aby zezwolić wszystkim (NIEZALECANE)
ALLOWED_NUMBERS=+48XXXXXXXXX,+48YYYYYYYYY

# Token dla API serwera na telefonie
API_TOKEN=zmien_na_losowy_token_min_32_znaki

# ── Homelab integration ───────────────────────────────────
HOMELAB_WEBHOOK_URL=http://192.168.1.100:8080/webhook/sms

# URL API serwera na telefonie (przez reverse tunnel lub lokalnie)
PHONE_API_URL=http://localhost:9022

# ── Sieć ─────────────────────────────────────────────────
HOMELAB_HOST=192.168.1.100
HOMELAB_USER=pi
TUNNEL_PORT=9022
GATEWAY_PORT=8080

# ── Sensory ───────────────────────────────────────────────
# Jak często zbierać sensory (sekundy)
SENSOR_INTERVAL_S=10

# ── API Server ────────────────────────────────────────────
API_PORT=7788

# ── Opcjonalne ────────────────────────────────────────────
# Klucz OpenAI dla transkrypcji audio (Whisper)
# OPENAI_API_KEY=sk-...

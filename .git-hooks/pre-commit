#!/bin/bash
# pre-commit hook
# Checks before each commit:
#   1. No .env files in staged files
#   2. No sk-ant- API keys in staged Python/sh/yaml files
#   3. Python syntax OK (py_compile) for staged .py files

set -e

ERRORS=0

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# ── 1. Check for .env files ──────────────────────────────────────────────────
ENV_FILES=$(echo "$STAGED_FILES" | grep -E '(^|/)\.env$' || true)
if [ -n "$ENV_FILES" ]; then
    echo "[pre-commit] ERROR: Attempting to commit .env file(s):" >&2
    echo "$ENV_FILES" | sed 's/^/  /' >&2
    ERRORS=$((ERRORS + 1))
fi

# ── 2. Check for sk-ant- API keys in source files ────────────────────────────
SOURCE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(py|sh|yaml|yml)$' || true)
if [ -n "$SOURCE_FILES" ]; then
    for FILE in $SOURCE_FILES; do
        if [ -f "$FILE" ]; then
            if git show ":$FILE" | grep -q 'sk-ant-'; then
                echo "[pre-commit] ERROR: sk-ant- API key found in staged file: $FILE" >&2
                ERRORS=$((ERRORS + 1))
            fi
        fi
    done
fi

# ── 3. Python syntax check for staged .py files ──────────────────────────────
PY_FILES=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
if [ -n "$PY_FILES" ]; then
    for FILE in $PY_FILES; do
        if [ -f "$FILE" ]; then
            # Write staged content to a temp file and check syntax
            TMPFILE=$(mktemp /tmp/pre-commit-py-XXXXXX.py)
            git show ":$FILE" > "$TMPFILE"
            if ! python3 -m py_compile "$TMPFILE" 2>/dev/null; then
                echo "[pre-commit] ERROR: Python syntax error in staged file: $FILE" >&2
                python3 -m py_compile "$TMPFILE" 2>&1 | sed "s|$TMPFILE|$FILE|g" >&2
                ERRORS=$((ERRORS + 1))
            fi
            rm -f "$TMPFILE"
        fi
    done
fi

# ── Result ───────────────────────────────────────────────────────────────────
if [ "$ERRORS" -gt 0 ]; then
    echo "[pre-commit] Commit aborted: $ERRORS error(s) found." >&2
    exit 1
fi

echo "[pre-commit] All checks passed."
exit 0
